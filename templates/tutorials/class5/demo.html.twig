<!doctype html>
<html lang="en">
<head>
 <meta charset="utf-8">
 <title>Club data</title>
</head>
<body>
 <h1>Hello {{ name }}</h1>
 <p>Meet {{ meeting.day }} in {{ meeting.room }}.</p>
 <p>Featured: {{ product.getDescription() }} — ${{
product.price|number_format(2) }}</p>
 <p>Summary: {{ product }}</p>
 <ul>
 {% for item in products %}
 <li>{{ item.description }} — ${{ item.price|number_format(2) }}</li>
 {% else %}
 <li>No products available.</li>
 {% endfor %}
 </ul>
</body>
</html>